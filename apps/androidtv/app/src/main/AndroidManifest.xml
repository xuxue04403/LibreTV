<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- DLNA 接收端需要接收 SSDP 组播 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 电视盒子与手机形态都在用：谁都不强制要求触摸屏或 Wi-Fi（很多盒子走有线） -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!--
        这里只放两端共用的部分（进程级 Application、图标、主题、明文流量开关）。
        启动 Activity 与形态相关的声明分别放在 src/tv 与 src/phone 的清单里，
        由清单合并按 flavor 组装：电视版横屏 + Leanback 入口，手机版竖屏 + 触摸。
    -->
    <application
        android:name=".LibreXtvApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreXTV"
        android:usesCleartextTraffic="true" />
</manifest>
