{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@librextv/core": ["../../packages/core/src/index.ts"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@defaults": ["../../defaults/sources.json"]
